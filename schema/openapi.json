      "FillPdfRequest": {
        "properties": {
          "borderColor": {
            "description": "Default border color for field bounding boxes, as a CSS hex color.",
            "type": "string"
          },
          "data": {
            "description": "The field data to fill into the template. Can be a single object keyed by\nfield ID or alias, or an array of objects for multi-page / repeating fills.\nEach value can be a primitive (string, number, boolean), or a value object\nwith a `value` key alongside styling overrides.\n",
            "oneOf": [
              {
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "description": "A value object with optional per-field styling overrides.",
                      "properties": {
                        "value": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "items": {
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "properties": {
                          "value": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          }
                        },
                        "type": "object"
                      }
                    ]
                  },
                  "type": "object"
                },
                "type": "array"
              }
            ]
          },
          "defaultCheckboxCharacter": {
            "description": "The character used to represent a checked checkbox.",
            "type": "string"
          },
          "defaultMakeCheckboxSquare": {
            "description": "When true, checkbox fields are rendered as squares instead of the default shape.",
            "type": "boolean"
          },
          "defaultReadOnly": {
            "description": "Controls whether interactive AcroForm fields default to read-only.\nOnly applicable when `useInteractiveFields` is true. Defaults to false\nwhen `useInteractiveFields` is enabled.\n",
            "type": "boolean"
          },
          "drawDebugBoxes": {
            "description": "When true, draws visible bounding boxes around each field for debugging layout issues.",
            "type": "boolean"
          },
          "fontFamily": {
            "description": "Default font family name for all fields.",
            "type": "string"
          },
          "fontSize": {
            "description": "Default font size in points for all fields.",
            "maximum": 30,
            "minimum": 5,
            "type": "integer"
          },
          "outputFormat": {
            "default": "pdf",
            "description": "Controls the response format. When set to `url`, the filled PDF is\nuploaded to cloud storage and a JSON response with a short-lived signed\nURL is returned instead of the binary PDF. The signed URL expires 5\nminutes after generation. Defaults to `pdf` (binary PDF response).\n",
            "enum": [
              "pdf",
              "url"
            ],
            "type": "string"
          },
          "stripAnnotations": {
            "description": "When true, removes all PDF annotations from the output.",
            "type": "boolean"
          },
          "textColor": {
            "description": "Default text color for all fields, as a CSS hex color (e.g. `#FF0000`).",
            "type": "string"
          },
          "title": {
            "description": "Custom title for the generated PDF. Overrides the template's default title.",
            "type": "string"
          },
          "useInteractiveFields": {
            "description": "When true, the filled PDF will contain interactive AcroForm fields\nthat can be edited by the recipient in a PDF viewer. Requires a paid plan.\n",
            "type": "boolean"
          },
          "verticalAlignment": {
            "description": "Default vertical alignment for text within fields.",
            "enum": [
              "top",
              "middle",
              "bottom"
            ],
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "GenerateHtmlPdfRequest": {
        "description": "Generate a PDF by rendering raw HTML and optional CSS.",
        "properties": {
          "data": {
            "description": "The HTML content and optional CSS to render into a PDF.",
            "properties": {
              "css": {
                "description": "Optional CSS stylesheet applied to the HTML content during rendering.",
                "type": "string"
              },
              "html": {
                "description": "The HTML markup to render. This is the full body content of the PDF.",
                "type": "string"
              }
            },
            "required": [
              "html"
            ],
            "type": "object"
          },
          "outputFormat": {
            "default": "pdf",
            "description": "Controls the response format. When set to `url`, the generated PDF is\nuploaded to cloud storage and a JSON response with a short-lived signed\nURL is returned instead of the binary PDF. The signed URL expires 5\nminutes after generation. Defaults to `pdf` (binary PDF response).\n",
            "enum": [
              "pdf",
              "url"
            ],
            "type": "string"
          },
          "page": {
            "$ref": "#/components/schemas/PageOptions"
          },
          "title": {
            "description": "The document title. Used as the PDF metadata title and in the output filename.",
            "type": "string"
          },
          "type": {
            "description": "Set to `html` to explicitly select HTML-to-PDF rendering.",
            "enum": [
              "html"
            ],
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "GenerateMarkdownPdfRequest": {
        "description": "Generate a PDF from structured Markdown-style content blocks.\nEach item in the `data` array represents a content section that\ncan contain headings, labeled values, body text, or tables.\n",
        "properties": {
          "data": {
            "description": "An array of content blocks that make up the PDF body. Each block\ncan contain one or more of: `heading`, `label`, `content`, `table`.\n",
            "items": {
              "properties": {
                "content": {
                  "description": "Body text content, rendered as a paragraph. Supports Markdown formatting.",
                  "type": "string"
                },
                "fontFamily": {
                  "description": "Font family override for this content block.",
                  "type": "string"
                },
                "fontSize": {
                  "description": "Font size override for this content block.",
                  "maximum": 30,
                  "minimum": 5,
                  "type": "integer"
                },
                "heading": {
                  "description": "A section heading rendered in a larger, bold font.",
                  "type": "string"
                },
                "label": {
                  "description": "A label rendered in bold, typically used for key-value pairs.",
                  "type": "string"
                },
                "table": {
                  "description": "A table rendered inline in the PDF.",
                  "properties": {
                    "columnGridlines": {
                      "description": "When true, vertical gridlines are drawn between columns.",
                      "type": "boolean"
                    },
                    "columnOptions": {
                      "description": "Per-column display options.",
                      "items": {
                        "properties": {
                          "align": {
                            "description": "Horizontal text alignment for this column.",
                            "enum": [
                              "left",
                              "center",
                              "right"
                            ],
                            "type": "string"
                          },
                          "width": {
                            "description": "Column width as a percentage or pixel value (e.g. `25%`, `100px`).",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "firstRowHeaders": {
                      "description": "When true, the first row is rendered as a header row with bold styling.",
                      "type": "boolean"
                    },
                    "rowGridlines": {
                      "description": "When true, horizontal gridlines are drawn between rows.",
                      "type": "boolean"
                    },
                    "rows": {
                      "description": "Table data as a 2D array of strings (array of rows, each row is an array of cell values).",
                      "items": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "type": "array"
                    },
                    "verticalAlign": {
                      "description": "Vertical alignment of cell content.",
                      "enum": [
                        "top",
                        "center",
                        "bottom"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "rows"
                  ],
                  "type": "object"
                },
                "textColor": {
                  "description": "Text color override for this block, as a CSS hex color.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "fontFamily": {
            "description": "Default font family for the document.",
            "type": "string"
          },
          "fontSize": {
            "description": "Default font size in points for the document.",
            "maximum": 30,
            "minimum": 5,
            "type": "integer"
          },
          "includeTimestamp": {
            "description": "When true, a timestamp is printed on the PDF showing when it was generated.",
            "type": "boolean"
          },
          "logo": {
            "description": "A logo image to display at the top of the PDF. Set to `false` to\nexplicitly disable any default logo. Provide an object with a\nbase64-encoded or URL image source to include a logo.\n",
            "oneOf": [
              {
                "enum": [
                  false
                ],
                "type": "boolean"
              },
              {
                "properties": {
                  "maxHeight": {
                    "description": "Maximum height of the logo in pixels.",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "maxWidth": {
                    "description": "Maximum width of the logo in pixels.",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "src": {
                    "description": "Image source: a base64-encoded data URI or an HTTPS URL.",
                    "type": "string"
                  }
                },
                "required": [
                  "src"
                ],
                "type": "object"
              }
            ]
          },
          "outputFormat": {
            "default": "pdf",
            "description": "Controls the response format. When set to `url`, the generated PDF is\nuploaded to cloud storage and a JSON response with a short-lived signed\nURL is returned instead of the binary PDF. The signed URL expires 5\nminutes after generation. Defaults to `pdf` (binary PDF response).\n",
            "enum": [
              "pdf",
              "url"
            ],
            "type": "string"
          },
          "page": {
            "$ref": "#/components/schemas/PageOptions"
          },
          "textColor": {
            "description": "Default text color for the document, as a CSS hex color (e.g. `#333333`).",
            "type": "string"
          },
          "title": {
            "description": "The document title. Used as the PDF metadata title and in the output filename.",
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "PageOptions": {
        "description": "Custom page dimensions and margins for the generated PDF.",

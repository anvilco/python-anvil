          },
          "margin": {
            "description": "Shorthand margin for all sides (e.g. `0.5in`, `10mm 20mm`).",
            "type": "string"
          },
          "marginBottom": {
            "description": "Bottom margin with unit.",
            "type": "string"
          },
          "marginLeft": {
            "description": "Left margin with unit.",
            "type": "string"
          },
          "marginRight": {
            "description": "Right margin with unit.",
            "type": "string"
          },
          "marginTop": {
            "description": "Top margin with unit.",
            "type": "string"
          },
          "pageCount": {
            "description": "Position to render page numbers on each page.",
            "enum": [
              "topLeft",
              "topRight",
              "topCenter",
              "bottomLeft",
              "bottomRight",
              "bottomCenter"
            ],
            "type": "string"
          },
          "width": {
            "description": "Page width with unit (e.g. `8.5in`, `210mm`).",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "description": "Use your API key as the username with an empty password.",

  "info": {
    "description": "REST APIs for Anvil's document automation platform. Includes PDF filling, PDF generation, and more.",
    "title": "Anvil API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/document-group/{documentGroupEid}.zip": {
      "get": {
        "description": "Downloads every file in a document group as a single zip archive: for\nexample, the signed documents of an Etch signature packet, from its\n`documentGroup.eid`.\n\nInstead of streaming the zip, the response may be a `302` redirect to\na short-lived signed URL for it. Follow redirects to get the file.\n\nRequires API key (Basic auth) or OAuth authentication. Public OAuth\nclients need the `mcp:full` scope; no narrower scope covers this route.\n",
        "operationId": "downloadDocuments",
        "parameters": [
          {
            "description": "The EID of the document group, e.g. an Etch packet's `documentGroup.eid`.",
            "in": "path",
            "name": "documentGroupEid",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/zip": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The zip archive. `Content-Disposition` names it after the document\ngroup's parent object, such as the Etch packet.\n"
          },
          "302": {
            "description": "Redirect to a short-lived signed URL for the zip."
          },
          "401": {
            "description": "Authentication required \u2014 API key or OAuth token is missing or invalid."
          },
          "403": {
            "description": "The OAuth token belongs to a public client without a scope that covers this route."
          },
          "404": {
            "description": "Document group not found \u2014 no document group exists with the given EID, or the authenticated user lacks access to it."
          }
        },
        "security": [
          {
            "basicAuth": []
          },
          {
            "oauth2": []
          }
        ],
        "summary": "Download a document group's files as a zip",
        "tags": [
          "Documents"
        ]
      }
    },
    "/api/v1/fill/{castEid}.pdf": {
      "post": {
        "description": "Fills a PDF template (Cast) with the provided data and returns the resulting PDF.\n\nTemplates are created and managed in the Anvil dashboard or via the GraphQL `createCast` mutation.\nEach template defines named fields (text, date, checkbox, signature, etc.) that can be populated via\nthis endpoint. The field data can be supplied as a flat object keyed by field ID\nor alias, or as an array of objects for multi-page repeating templates.\n\nSupports both JSON and multipart/form-data request bodies. When using\nmultipart/form-data, string values for `fontSize` and `page` are automatically\nparsed.\n\nRequires API key (Basic auth) or OAuth authentication. Development API keys\nproduce watermarked PDFs; production keys produce clean PDFs and count toward\nyour plan's usage.\n",
        "operationId": "fillPdf",
        "parameters": [
          {
            "description": "The EID (external identifier) of the PDF template (Cast) to fill.",
            "in": "path",
            "name": "castEid",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The version number of the template to use. If omitted, the latest\npublished version is used. Use this to pin fills to a specific\ntemplate revision.\n",
            "in": "query",
